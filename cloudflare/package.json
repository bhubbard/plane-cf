{
  "name": "plane-cloudflare",
  "version": "1.4.2",
  "description": "Plane project management edge suite running on Cloudflare services (Workers, D1, R2, KV, Durable Objects, Queues, Hyperdrive)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply plane-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply plane-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "^4.149.0"
  }
}
