# ==============================================================================
# Plane Cloudflare Services Environment Configuration
# ==============================================================================

# Site Domain & Base URLs
APP_DOMAIN=plane.yourdomain.com
SITE_ADDRESS=plane.yourdomain.com
WEB_URL=https://plane.yourdomain.com
DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane.yourdomain.com

# Database Settings (Direct PostgreSQL or via Cloudflare Hyperdrive)
# Hyperdrive provides connection pooling and edge read caching:
DATABASE_URL=postgresql://plane:plane_secret_pass@plane-db:5432/plane
# Or Hyperdrive pooled URL:
# DATABASE_URL=postgresql://user:pass@plane-hyperdrive.cloudflare.net:5432/plane?sslmode=require

# Redis Settings
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ Settings
AMQP_URL=amqp://plane:plane_secret_pass@plane-mq:5672/plane

# Application Secret Key
SECRET_KEY=generate-a-secure-random-secret-key-32-chars

# Cloudflare R2 Object Storage (Zero-Egress S3-Compatible)
USE_MINIO=0
AWS_REGION=auto
AWS_S3_ENDPOINT_URL=https://1175740cdf81970b9d1522fe245099de.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=plane-files
BUCKET_NAME=plane-files
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
FILE_SIZE_LIMIT=52428800
SIGNED_URL_EXPIRATION=3600

# Cloudflare Edge Gateway URL
API_BASE_URL=https://plane.yourdomain.com
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_PATH=/spaces
LIVE_BASE_PATH=/live

# Live Server Secret Key
LIVE_SERVER_SECRET_KEY=generate-a-secure-random-live-secret-key
USE_DURABLE_OBJECTS_FOR_LIVE=true

# Rate Limits
API_KEY_RATE_LIMIT=120/minute
AUTHENTICATION_RATE_LIMIT=30/minute
